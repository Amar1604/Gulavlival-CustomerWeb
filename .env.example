# Gulavlival Grand Master Environment Configuration

# ---------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gulavlival_grand
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/gulavlival_grand

# ---------------------------------------------
# Backend API (FastAPI)
# ---------------------------------------------
SECRET_KEY=your_secret_jwt_key_generate_using_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# ---------------------------------------------
# Customer Frontend (Next.js)
# ---------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Gulavlival Grand"
NEXT_PUBLIC_ENABLE_QR_ORDERING=true
NEXT_PUBLIC_ENABLE_DELIVERY=true
NEXT_PUBLIC_ENABLE_TAKEAWAY=true
NEXT_PUBLIC_ENABLE_DINE_IN=true
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# ---------------------------------------------
# Supabase Configuration
# ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=menu-photos
